# Copy to .env.local for local development (npm run dev).
# On Vercel, add these under Project → Settings → Environment Variables.

# --- Sign-in (required: one of these) ---
APP_PASSWORD=choose-a-long-password
# Or several people, each with their own chat history (overrides APP_PASSWORD):
# APP_USERS="Mei:her-password, Alvin:your-password"

# Signs the login cookie. Generate with:  openssl rand -hex 32
AUTH_SECRET=

# --- AI providers (at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Chat history storage (added for you by Vercel's Upstash integration) ---
# Leave empty locally to use a file in .data/
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Spending cap (estimated, shared by all users) ---
BUDGET_USD=100
# BUDGET_PERIOD=month          # or: total (never resets)
# BUDGET_TIMEZONE=Asia/Singapore
# PRICES_JSON={"gpt-6.1-terra":{"input":1,"cachedInput":0.05,"output":5}}

# --- Optional ---
APP_NAME=My Assistant
# DEFAULT_MODEL=claude-sonnet-5-5
# IMAGE_MODEL=gpt-image-2.5-flare
# IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst
# TITLE_MODEL=claude-haiku-5-5
# WEB_SEARCH_MAX_USES=5
# ANTHROPIC_MAX_TOKENS=16000
# ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305
# MODELS_JSON=[{"id":"claude-sonnet-5-5","provider":"anthropic","label":"Claude Sonnet 5.5","description":"Everyday"}]
